{
  "rules": {
    ".read": false,
    ".write": false,
    "schools": {
      "$schoolId": {
        "security": {
          "users": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('role').val() === 'admin'",
              ".validate": "newData.hasChildren(['uid','role','active']) && newData.child('uid').val() === $uid && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'guru' || newData.child('role').val() === 'siswa' || newData.child('role').val() === 'wakel' || newData.child('role').val() === 'petugas') && newData.child('active').isBoolean()"
            }
          },
          "legacyUsers": {
            ".read": false,
            ".write": false
          },
          "legacyPiketUsers": {
            ".read": false,
            ".write": false
          },
          "sessions": {
            ".read": false,
            ".write": false
          },
          "terminalUsers": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": false,
              ".validate": "newData.hasChildren(['uid','role','active','identifier']) && newData.child('uid').val() === $uid && newData.child('role').val() === 'terminal' && newData.child('active').isBoolean() && newData.child('identifier').isString()"
            }
          }
        },
