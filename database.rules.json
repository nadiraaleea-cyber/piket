              ".write": "auth != null && ((root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true && (root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('role').val() === 'admin' || root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('role').val() === 'guru' || root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('role').val() === 'petugas')) || root.child('schools').child($schoolId).child('security').child('terminalUsers').child(auth.uid).child('active').val() === true)"
