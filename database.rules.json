            },
            "kejadian": {
              ".read": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true",
              ".write": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true"
            },
            "tugas": {
              ".read": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true",
              ".write": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true"
            },
            "absensiPetugas": {
              ".read": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true",
              ".write": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true"
            }
          },
          "messages": {
            ".read": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true",
            ".write": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('role').val() === 'admin'"
          },
          "settings": {
            ".read": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true",
            ".write": "auth != null && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('active').val() === true && root.child('schools').child($schoolId).child('security').child('users').child(auth.uid).child('role').val() === 'admin'"
          }
